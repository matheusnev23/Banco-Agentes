# Backend FastAPI - Banco Ágil
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Host e porta do servidor
HOST=0.0.0.0
PORT=8000

# Origens permitidas para CORS (separadas por vírgula)
# O frontend Vite roda em localhost:5173 por padrão
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nome da aplicação
APP_NAME=Banco Ágil - Backend
APP_VERSION=0.1.0

# Chave de API da OpenAI (opcional - usada pelo agente LLM)
# Deixe vazio para usar o agente baseado em regras (mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
